PORT=5000
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>?retryWrites=true&w=majority
JWT_SECRET=<secreto-aleatorio-largo>
# Uno o más orígenes exactos separados por coma, sin barra final.
FRONTEND_URLS=https://mi-frontend.vercel.app
# URL pública base del servicio Render, sin /api ni barra final.
PUBLIC_API_URL=https://mi-backend.onrender.com
# En Render Free es temporal; las imágenes pueden perderse al reiniciar.
UPLOADS_DIR=/tmp/osmar-figuras-uploads
